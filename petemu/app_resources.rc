#include <winres.h>
// wxWidgets stock resources (wxCURSOR_BLANK for the fullscreen cursor hide).
// The linker embeds petemu.manifest, so leave wx.rc's manifest out.
#define wxUSE_NO_MANIFEST 1
#include "wx/msw/wx.rc"
appicon ICON "petemu.ico"
// The version numbers come from project() in CMakeLists.txt (pet_gui_target).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION PETGPT_VERSION_RC
 PRODUCTVERSION PETGPT_VERSION_RC
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Pet-GPT Commodore PET/CBM Emulator"
   VALUE "FileVersion", PETGPT_VERSION_FULL
   VALUE "ProductVersion", PETGPT_VERSION_FULL
   VALUE "ProductName", "Pet-GPT"
   VALUE "LegalCopyright", "Copyright (C) 2026 Tim Cottrill. GPL v3."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
