<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-commodore-prg">
    <comment>Commodore program</comment>
    <glob pattern="*.prg"/>
    <glob pattern="*.PRG"/>
  </mime-type>
  <mime-type type="application/x-commodore-p00">
    <comment>Commodore PC64 program container</comment>
    <magic priority="60"><match type="string" value="C64File" offset="0"/></magic>
    <glob pattern="*.p00"/>
    <glob pattern="*.P00"/>
  </mime-type>
  <mime-type type="application/x-commodore-t64">
    <comment>Commodore tape container</comment>
    <glob pattern="*.t64"/>
    <glob pattern="*.T64"/>
  </mime-type>
  <mime-type type="application/x-commodore-tap">
    <comment>Commodore cassette tape image</comment>
    <glob pattern="*.tap"/>
    <glob pattern="*.TAP"/>
  </mime-type>
  <mime-type type="application/x-commodore-d64">
    <comment>Commodore 1541 disk image</comment>
    <glob pattern="*.d64"/>
    <glob pattern="*.D64"/>
  </mime-type>
  <mime-type type="application/x-commodore-d71">
    <comment>Commodore 1571 disk image</comment>
    <glob pattern="*.d71"/>
    <glob pattern="*.D71"/>
  </mime-type>
</mime-info>
